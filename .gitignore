# Byte-compiled
__pycache__/
*.py[cod]
*.so

# Environments
.venv/
venv/
.env
*.env
.env.*

# Model checkpoints (never commit — large binaries)
checkpoints/
*.pt
*.pth
*.safetensors
*.bin

# Experiment outputs.
#
# Results are small and are the evidence for the claims, so they are tracked:
# aggregates, per-run JSON records, the edge datasets, and the figures with
# their source data. What is NOT tracked is anything heavy or throwaway.
results/smoke/
results/gpu_smoke/
results/**/raw/
*.tgz

