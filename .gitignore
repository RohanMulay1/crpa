# Byte-compiled
__pycache__/
*.py[cod]
*.so

# Environments
.venv/
venv/
.env
*.env
.env.*

# Model checkpoints (never commit — large binaries)
checkpoints/
*.pt
*.pth
*.safetensors
*.bin

# Experiment outputs.
#
# Results are small and are the evidence for the claims, so they are tracked:
# aggregates, per-run JSON records, the edge datasets, and the figures with
# their source data. What is NOT tracked is anything heavy or throwaway.
results/smoke/
results/gpu_smoke/
results/**/raw/
*.tgz

# Legacy text tables are regenerated by every `python main.py` run from
# whatever that run produced. The structured aggregates are the record, and
# the originally published artifacts live in results/original_published/.
results/table2_main.txt
results/table4_ablation.txt
results/table3_scaling.txt
results/table5_routing.txt
results/multiseed.txt

# Caches
.pytest_cache/
.hypothesis/
.ipynb_checkpoints/
*.log
!results/run_a6000.log

# OS
.DS_Store
Thumbs.db
